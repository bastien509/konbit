{
    "name": "apimatic-sdks/konbitworkeventsapi",
    "description": "Send proof of work (a merged pull request, a client's approval email, a finished calendar session, an Upwork or Notion update) to your Konbit workspace. Claude reviews it, matches it to an open milestone and proposes a PayPal payout. The server then applies your signed mandate: the payout is sent at once, waits for your approval, or is blocked.  Evidence is treated as untrusted text. It can never add a payee or raise a limit.  Use the generated SDKs from Zapier steps, GitHub Actions or your own scripts. ",
    "type": "library",
    "keywords": [
        "Konbit Work Events API",
        "API",
        "SDK"
    ],
    "homepage": "https://petiht.com/freelanceragent/",
    "license": [
        "MIT"
    ],
    "authors": [
        {
            "name": "Konbit (Petiht)",
            "email": "support@apimatic.io",
            "homepage": "https://petiht.com/freelanceragent/"
        }
    ],
    "prefer-stable": false,
    "require": {
        "php": ">=7.2 <8.2 || ~8.2.35 || ~8.3.36 || ~8.4.27 || ^8.5.12",
        "ext-json": "*",
        "ext-curl": "*",
        "apimatic/unirest-php": "^4.0.6",
        "apimatic/core-interfaces": "~0.1.5",
        "apimatic/core": "~0.3.17"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.5",
        "phan/phan": "5.4.5",
        "phpunit/phpunit": "^7.5 || ^8.5 || ^9.5 || ^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "KonbitWorkEventsAPILib\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KonbitWorkEventsAPILib\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html=coverage",
        "lint-src": "phpcs --standard=phpcs-ruleset.xml src/",
        "lint-src-fix": "phpcbf --standard=phpcs-ruleset.xml src/",
        "lint-tests": "phpcs --standard=phpcs-ruleset.xml tests/",
        "lint-tests-fix": "phpcbf --standard=phpcs-ruleset.xml tests/",
        "analyze": "phan --allow-polyfill-parser -p",
        "lint": [
            "@lint-src",
            "@lint-tests"
        ]
    }
}