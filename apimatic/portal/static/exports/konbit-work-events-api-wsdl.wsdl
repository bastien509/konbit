<?xml version="1.0" encoding="utf-8"?>
<definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:schemas="https://petiht.com/freelanceragent/schemas" xmlns:wsdl="https://petiht.com/freelanceragent/wsdl" targetNamespace="https://petiht.com/freelanceragent/wsdl" xmlns="http://schemas.xmlsoap.org/wsdl/">
  <types>
    <xs:schema xmlns:tns="https://petiht.com/freelanceragent/schemas" targetNamespace="https://petiht.com/freelanceragent/schemas" xmlns:xs="http://www.w3.org/2001/XMLSchema">
      <xs:element name="POST_submitWorkEvent_InputMessage" type="schemas:POST_submitWorkEvent_InputMessage" />
      <xs:element name="POST_submitWorkEvent_OutputMessage" type="schemas:POST_submitWorkEvent_OutputMessage" />
      <xs:element name="POST_submitWorkEvent_400" type="schemas:POST_submitWorkEvent_400" />
      <xs:element name="POST_submitWorkEvent_401" type="schemas:POST_submitWorkEvent_401" />
      <xs:element name="POST_submitWorkEvent_413" type="schemas:POST_submitWorkEvent_413" />
      <xs:element name="POST_submitWorkEvent_422" type="schemas:POST_submitWorkEvent_422" />
      <xs:element name="POST_submitWorkEvent_429" type="schemas:POST_submitWorkEvent_429" />
      <xs:element name="GET_getWorkEvent_InputMessage" type="schemas:GET_getWorkEvent_InputMessage" />
      <xs:element name="GET_getWorkEvent_OutputMessage" type="schemas:GET_getWorkEvent_OutputMessage" />
      <xs:element name="GET_getWorkEvent_401" type="schemas:GET_getWorkEvent_401" />
      <xs:element name="GET_getWorkEvent_404" type="schemas:GET_getWorkEvent_404" />
      <xs:simpleType name="EvidenceSource">
        <xs:annotation>
          <xs:documentation>Where the evidence came from.</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
          <xs:enumeration value="email" />
          <xs:enumeration value="github" />
          <xs:enumeration value="calendar" />
          <xs:enumeration value="upwork" />
          <xs:enumeration value="notion" />
          <xs:enumeration value="slack" />
          <xs:enumeration value="api" />
          <xs:enumeration value="manual" />
        </xs:restriction>
      </xs:simpleType>
      <xs:simpleType name="EventStatus">
        <xs:annotation>
          <xs:documentation>Review result: done = payout proposed, ignored = no action, flagged = suspicious.</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
          <xs:enumeration value="new" />
          <xs:enumeration value="analyzing" />
          <xs:enumeration value="done" />
          <xs:enumeration value="ignored" />
          <xs:enumeration value="flagged" />
          <xs:enumeration value="error" />
        </xs:restriction>
      </xs:simpleType>
      <xs:simpleType name="RiskLevel">
        <xs:annotation>
          <xs:documentation>How risky the agent and the risk scan judged the evidence.</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
          <xs:enumeration value="low" />
          <xs:enumeration value="medium" />
          <xs:enumeration value="high" />
        </xs:restriction>
      </xs:simpleType>
      <xs:simpleType name="PlanDecision">
        <xs:annotation>
          <xs:documentation>What the signed mandate decided for a payout plan.</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
          <xs:enumeration value="auto" />
          <xs:enumeration value="ask" />
          <xs:enumeration value="block" />
        </xs:restriction>
      </xs:simpleType>
      <xs:simpleType name="PlanStatus">
        <xs:annotation>
          <xs:documentation>The payout plan's current status.</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
          <xs:enumeration value="needs_approval" />
          <xs:enumeration value="blocked" />
          <xs:enumeration value="scheduled" />
          <xs:enumeration value="sending" />
          <xs:enumeration value="sent" />
          <xs:enumeration value="paid" />
          <xs:enumeration value="partial" />
          <xs:enumeration value="failed" />
          <xs:enumeration value="rejected" />
        </xs:restriction>
      </xs:simpleType>
      <xs:complexType name="WorkEventInput">
        <xs:annotation>
          <xs:documentation>Work evidence to send to the agent.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
          <xs:element minOccurs="0" default="api" name="source" type="schemas:EvidenceSource">
            <xs:annotation>
              <xs:documentation>Where the evidence came from.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="title">
            <xs:simpleType>
              <xs:annotation>
                <xs:documentation>A short title, such as an email subject.</xs:documentation>
              </xs:annotation>
              <xs:restriction base="xs:string">
                <xs:maxLength value="160" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element minOccurs="1" name="text">
            <xs:simpleType>
              <xs:annotation>
                <xs:documentation>The raw evidence. It is treated as untrusted data.</xs:documentation>
              </xs:annotation>
              <xs:restriction base="xs:string">
                <xs:maxLength value="6000" />
                <xs:minLength value="10" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="WorkEventResult">
        <xs:annotation>
          <xs:documentation>The agent's review of one piece of evidence.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
          <xs:element minOccurs="1" name="event_id" type="xs:integer">
            <xs:annotation>
              <xs:documentation>Event identifier.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="status" type="schemas:EventStatus">
            <xs:annotation>
              <xs:documentation>Review result: done = payout proposed, ignored = no action, flagged = suspicious.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="risk" type="schemas:RiskLevel">
            <xs:annotation>
              <xs:documentation>How risky the agent and the risk scan judged the evidence.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="summary" nillable="true" type="xs:string">
            <xs:annotation>
              <xs:documentation>The agent's one or two sentence summary.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" maxOccurs="unbounded" name="plans" type="schemas:PayoutPlan">
            <xs:annotation>
              <xs:documentation>Payout plans created from this evidence.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="PayoutPlan">
        <xs:annotation>
          <xs:documentation>A proposed or completed PayPal payout.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
          <xs:element minOccurs="1" name="plan_id" type="xs:integer">
            <xs:annotation>
              <xs:documentation>Plan identifier.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="title" type="xs:string">
            <xs:annotation>
              <xs:documentation>Who is paid and for what.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="total_cents" type="xs:integer">
            <xs:annotation>
              <xs:documentation>Total in US cents.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="decision" type="schemas:PlanDecision">
            <xs:annotation>
              <xs:documentation>What the signed mandate decided for a payout plan.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="1" name="status" type="schemas:PlanStatus">
            <xs:annotation>
              <xs:documentation>The payout plan's current status.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="ApiError">
        <xs:annotation>
          <xs:documentation>An error response.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
          <xs:element minOccurs="1" name="error" type="xs:string">
            <xs:annotation>
              <xs:documentation>A short machine-readable error code.</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="message" type="xs:string">
            <xs:annotation>
              <xs:documentation>A human-readable explanation, when available.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="POST_submitWorkEvent_InputMessage">
        <xs:sequence>
          <xs:element minOccurs="1" fixed="application/json" name="Content-Type" type="xs:string" />
          <xs:element minOccurs="1" name="body" type="schemas:WorkEventInput">
            <xs:annotation>
              <xs:documentation>The evidence to review. Only `text` is required.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="POST_submitWorkEvent_OutputMessage">
        <xs:sequence>
          <xs:element minOccurs="1" name="response201" type="schemas:WorkEventResult">
            <xs:annotation>
              <xs:documentation>The agent's review of one piece of evidence.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="POST_submitWorkEvent_400">
        <xs:sequence>
          <xs:element minOccurs="1" name="response400" type="schemas:ApiError">
            <xs:annotation>
              <xs:documentation>An error response.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="POST_submitWorkEvent_401">
        <xs:sequence>
          <xs:element minOccurs="1" name="response401" type="schemas:ApiError">
            <xs:annotation>
              <xs:documentation>An error response.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="POST_submitWorkEvent_413">
        <xs:sequence>
          <xs:element minOccurs="1" name="response413" type="schemas:ApiError">
            <xs:annotation>
              <xs:documentation>An error response.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="POST_submitWorkEvent_422">
        <xs:sequence>
          <xs:element minOccurs="1" name="response422" type="schemas:ApiError">
            <xs:annotation>
              <xs:documentation>An error response.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="POST_submitWorkEvent_429">
        <xs:sequence>
          <xs:element minOccurs="1" name="response429" type="schemas:ApiError">
            <xs:annotation>
              <xs:documentation>An error response.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="GET_getWorkEvent_InputMessage">
        <xs:sequence>
          <xs:element minOccurs="1" name="event_id">
            <xs:simpleType>
              <xs:annotation>
                <xs:documentation>The `event_id` returned by submitWorkEvent.</xs:documentation>
              </xs:annotation>
              <xs:restriction base="xs:integer">
                <xs:minInclusive value="1" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="GET_getWorkEvent_OutputMessage">
        <xs:sequence>
          <xs:element minOccurs="1" name="response200" type="schemas:WorkEventResult">
            <xs:annotation>
              <xs:documentation>The agent's review of one piece of evidence.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="GET_getWorkEvent_401">
        <xs:sequence>
          <xs:element minOccurs="1" name="response401" type="schemas:ApiError">
            <xs:annotation>
              <xs:documentation>An error response.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="GET_getWorkEvent_404">
        <xs:sequence>
          <xs:element minOccurs="1" name="response404" type="schemas:ApiError">
            <xs:annotation>
              <xs:documentation>An error response.</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
    </xs:schema>
  </types>
  <message name="POST_submitWorkEvent_InputMessage">
    <part name="POST_submitWorkEvent_InputMessage" element="schemas:POST_submitWorkEvent_InputMessage" />
  </message>
  <message name="POST_submitWorkEvent_OutputMessage">
    <part name="POST_submitWorkEvent_OutputMessage" element="schemas:POST_submitWorkEvent_OutputMessage" />
