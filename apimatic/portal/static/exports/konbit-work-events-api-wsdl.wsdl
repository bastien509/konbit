  <portType name="Konbit_x0020_Work_x0020_Events_x0020_API_PortType">
    <operation name="POST_submitWorkEvent">
      <documentation>Stores the evidence, asks the Konbit agent (Claude) to review it, and returns the
review together with any payout plans it created. A plan's `decision` tells you
what the signed mandate allowed: `auto` (paid with PayPal Payouts), `ask`
(waiting for the freelancer's approval) or `block` (refused by policy).
</documentation>
      <input message="wsdl:POST_submitWorkEvent_InputMessage" />
      <output message="wsdl:POST_submitWorkEvent_OutputMessage">
        <documentation>The agent reviewed the evidence.</documentation>
      </output>
      <fault name="POST_submitWorkEvent_400" message="wsdl:POST_submitWorkEvent_400">
        <documentation>The body is not valid JSON.</documentation>
      </fault>
      <fault name="POST_submitWorkEvent_401" message="wsdl:POST_submitWorkEvent_401">
        <documentation>Missing or wrong X-Konbit-Key.</documentation>
      </fault>
      <fault name="POST_submitWorkEvent_413" message="wsdl:POST_submitWorkEvent_413">
        <documentation>The body is larger than 50 KB.</documentation>
      </fault>
      <fault name="POST_submitWorkEvent_422" message="wsdl:POST_submitWorkEvent_422">
        <documentation>The evidence was rejected (for example, too short) or could not be reviewed.</documentation>
      </fault>
      <fault name="POST_submitWorkEvent_429" message="wsdl:POST_submitWorkEvent_429">
        <documentation>Rate limited (20 events per hour per workspace).</documentation>
      </fault>
    </operation>
    <operation name="GET_getWorkEvent">
      <documentation>Returns the agent's review of an event submitted earlier, with the current status of every payout plan it created.</documentation>
      <input message="wsdl:GET_getWorkEvent_InputMessage" />
      <output message="wsdl:GET_getWorkEvent_OutputMessage">
        <documentation>The event and its plans.</documentation>
      </output>
      <fault name="GET_getWorkEvent_401" message="wsdl:GET_getWorkEvent_401">
        <documentation>Missing or wrong X-Konbit-Key.</documentation>
      </fault>
      <fault name="GET_getWorkEvent_404" message="wsdl:GET_getWorkEvent_404">
        <documentation>No such event in this workspace.</documentation>
      </fault>
    </operation>
  </portType>
  <binding name="Konbit_x0020_Work_x0020_Events_x0020_API_Binding" type="wsdl:Konbit_x0020_Work_x0020_Events_x0020_API_PortType">
    <soap:binding transport="http://schemas.xmlsoap.org/soap/http" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" />
    <operation name="POST_submitWorkEvent">
      <soap:operation soapAction="POST_submitWorkEvent" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" />
      <input>
        <soap:body use="literal" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" />
      </input>
      <output>
        <soap:body use="literal" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" />
      </output>
      <fault name="POST_submitWorkEvent_400">
        <soap:fault use="literal" name="POST_submitWorkEvent_400" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" />
      </fault>
      <fault name="POST_submitWorkEvent_401">
        <soap:fault use="literal" name="POST_submitWorkEvent_401" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" />
      </fault>
      <fault name="POST_submitWorkEvent_413">
        <soap:fault use="literal" name="POST_submitWorkEvent_413" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" />
      </fault>
      <fault name="POST_submitWorkEvent_422">
        <soap:fault use="literal" name="POST_submitWorkEvent_422" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" />
      </fault>
      <fault name="POST_submitWorkEvent_429">
        <soap:fault use="literal" name="POST_submitWorkEvent_429" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" />
      </fault>
    </operation>
    <operation name="GET_getWorkEvent">
      <soap:operation soapAction="GET_getWorkEvent" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" />
      <input>
        <soap:body use="literal" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" />
      </input>
      <output>
        <soap:body use="literal" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" />
      </output>
      <fault name="GET_getWorkEvent_401">
        <soap:fault use="literal" name="GET_getWorkEvent_401" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" />
      </fault>
      <fault name="GET_getWorkEvent_404">
        <soap:fault use="literal" name="GET_getWorkEvent_404" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" />
      </fault>
    </operation>
  </binding>
  <service name="Konbit_x0020_Work_x0020_Events_x0020_API">
    <documentation>Send proof of work (a merged pull request, a client's approval email, a finished
calendar session, an Upwork or Notion update) to your Konbit workspace. Claude
reviews it, matches it to an open milestone and proposes a PayPal payout. The
server then applies your signed mandate: the payout is sent at once, waits for
your approval, or is blocked.

Evidence is treated as untrusted text. It can never add a payee or raise a limit.

Use the generated SDKs from Zapier steps, GitHub Actions or your own scripts.
</documentation>
    <port name="default_Port" binding="wsdl:Konbit_x0020_Work_x0020_Events_x0020_API_Binding">
      <soap:address location="https://petiht.com/freelanceragent" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" />
    </port>
  </service>
