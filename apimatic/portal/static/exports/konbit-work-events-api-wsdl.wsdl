    <part name="POST_submitWorkEvent_400" element="schemas:POST_submitWorkEvent_400" />
  </message>
  <message name="POST_submitWorkEvent_401">
    <part name="POST_submitWorkEvent_401" element="schemas:POST_submitWorkEvent_401" />
  </message>
  <message name="POST_submitWorkEvent_413">
    <part name="POST_submitWorkEvent_413" element="schemas:POST_submitWorkEvent_413" />
  </message>
  <message name="POST_submitWorkEvent_422">
    <part name="POST_submitWorkEvent_422" element="schemas:POST_submitWorkEvent_422" />
  </message>
  <message name="POST_submitWorkEvent_429">
    <part name="POST_submitWorkEvent_429" element="schemas:POST_submitWorkEvent_429" />
  </message>
  <message name="GET_getWorkEvent_InputMessage">
    <part name="GET_getWorkEvent_InputMessage" element="schemas:GET_getWorkEvent_InputMessage" />
  </message>
  <message name="GET_getWorkEvent_OutputMessage">
    <part name="GET_getWorkEvent_OutputMessage" element="schemas:GET_getWorkEvent_OutputMessage" />
  </message>
